{
  "name": "nuvemshop-kit",
  "version": "0.2.0",
  "description": "Kit em TypeScript para criar apps da Nuvemshop/Tiendanube: cliente da API com paginação e retry, OAuth, verificação de webhooks e handlers LGPD.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nuvemshop",
    "tiendanube",
    "ecommerce",
    "api",
    "sdk",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
